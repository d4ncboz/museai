# ---- server ----
MUSE2API_HOST=127.0.0.1
MUSE2API_PORT=18610
MUSE2API_LOG_LEVEL=INFO
# External base URL for media links; empty = derive from request
MUSE2API_PUBLIC_BASE=

# ---- auth ----
# Empty = auto-generate and store in data/api_key
MUSE2API_API_KEY=
# Empty = same as API key
MUSE2API_ADMIN_KEY=

# ---- storage ----
MUSE2API_DATA_DIR=data

# ---- driver: mock | browser | http ----
MUSE2API_DRIVER=mock

# browser driver
MUSE2API_CHROMIUM_PATH=
# Browser-only proxy. Leave empty when muse.ai is reachable directly.
# MUSE2API_BROWSER_PROXY=socks5://127.0.0.1:10808
MUSE2API_CDP_PORT=19210
MUSE2API_HEADLESS=true
MUSE2API_PAGE_READY_TIMEOUT=45

# ---- timeouts (seconds) ----
MUSE2API_CHAT_TIMEOUT=300
MUSE2API_FIRST_TOKEN_TIMEOUT=45
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=1500
# Render time one video job may spend on accounts in all, failovers included.
MUSE2API_VIDEO_JOB_DEADLINE=1800
# An account whose render timed out gets no new video job for this long while another is usable.
MUSE2API_STUCK_VIDEO_COOLDOWN=1800

# ---- account pool ----
# lru | round_robin | affinity
# affinity keeps one user on the same account so the hot page can be reused
MUSE2API_POOL_STRATEGY=affinity
MUSE2API_POOL_ACQUIRE_TIMEOUT=60
# Image/video jobs wait this long for a free account (each account renders one job at a time)
MUSE2API_MEDIA_QUEUE_TIMEOUT=0
MUSE2API_ACCOUNT_MAX_CONCURRENCY=6
MUSE2API_ACCOUNT_COOLDOWN=120
MUSE2API_MAX_FAILOVER=2

# ---- session keepalive ----
MUSE2API_KEEPALIVE_ENABLED=false
MUSE2API_KEEPALIVE_INTERVAL=21600

# ---- auto-post (docs/auto-post.md) ----
# MUSE2API_AUTOPOST_ENABLED=true
# Dry run: post through the mock driver only
# MUSE2API_AUTOPOST_MOCK=false
# Developer apps for "Connect" on the dashboard; redirect URI: <base>/dashboard/autopost/oauth/callback
MUSE2API_GOOGLE_CLIENT_ID=
MUSE2API_GOOGLE_CLIENT_SECRET=
MUSE2API_META_APP_ID=
MUSE2API_META_APP_SECRET=
MUSE2API_TIKTOK_CLIENT_KEY=
MUSE2API_TIKTOK_CLIENT_SECRET=
