# ---- server ----
MUSE2API_HOST=127.0.0.1
MUSE2API_PORT=18610
MUSE2API_LOG_LEVEL=INFO
# External base URL for media links; empty = derive from request
MUSE2API_PUBLIC_BASE=

# ---- auth ----
# Empty = auto-generate and store in data/api_key
MUSE2API_API_KEY=
# Empty = same as API key
MUSE2API_ADMIN_KEY=

# ---- storage ----
MUSE2API_DATA_DIR=data

# ---- driver: mock | browser | http ----
MUSE2API_DRIVER=mock

# browser driver
MUSE2API_CHROMIUM_PATH=
# Browser-only proxy. Leave empty when muse.ai is reachable directly.
# MUSE2API_BROWSER_PROXY=socks5://127.0.0.1:10808
MUSE2API_CDP_PORT=19210
MUSE2API_HEADLESS=true
MUSE2API_PAGE_READY_TIMEOUT=45

# ---- timeouts (seconds) ----
MUSE2API_CHAT_TIMEOUT=300
MUSE2API_FIRST_TOKEN_TIMEOUT=45
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600

# ---- account pool ----
# lru | round_robin | affinity
# affinity keeps one user on the same account so the hot page can be reused
MUSE2API_POOL_STRATEGY=affinity
MUSE2API_POOL_ACQUIRE_TIMEOUT=60
MUSE2API_ACCOUNT_MAX_CONCURRENCY=1
MUSE2API_ACCOUNT_COOLDOWN=120
MUSE2API_MAX_FAILOVER=2

# ---- session keepalive ----
MUSE2API_KEEPALIVE_ENABLED=false
MUSE2API_KEEPALIVE_INTERVAL=21600
