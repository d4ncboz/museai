    return next((set(v.get("posted", {})) for v in d.get("videos", []) if v["name"] == video_name), None)


def ensure_server():
    if server_running():
        return
    log = open(ROOT / "server.log", "ab")
    subprocess.Popen([sys.executable, __file__, "serve"], stdout=log, stderr=log, start_new_session=True)


def parse_schedule(at, tz):
    """"2026-11-07 19:00" in tz (default: this machine's zone) -> aware datetime; None = post now."""
    if not at:
        return None
    try:
        zone = ZoneInfo(tz) if tz else datetime.now().astimezone().tzinfo
    except ZoneInfoNotFoundError:
        sys.exit(f"unknown time zone: {tz} (use an IANA name like Asia/Ho_Chi_Minh)")
    try:
        when = datetime.fromisoformat(at.replace(" ", "T"))
    except ValueError:
        sys.exit(f"--at must look like 2026-11-07 19:00, got {at!r}")
    return when if when.tzinfo else when.replace(tzinfo=zone)


def x_weight(text):
    """X's own count (twitter-text v3): Latin-1 and general punctuation count 1, everything else
    (emoji, CJK, Vietnamese letters) 2, a link 23."""
    text = re.sub(r"https?://\S+", "x" * 23, text)
    light = ((0, 4351), (8192, 8205), (8208, 8223), (8242, 8247))
    return sum(1 if any(lo <= ord(c) <= hi for lo, hi in light) else 2 for c in text)


def x_fallback(yt_body, limit=280):
    """No X section in captions.txt: the YouTube title + its hashtags (minus #Shorts), trimmed to fit."""
    title, _, rest = yt_body.partition("\n")
    tags = [t for t in re.findall(r"#\w+", rest) if t.lower() != "#shorts"]
    text = title.strip()
    for t in tags:
        if x_weight(f"{text} {t}") > limit:
            break
        text = f"{text} {t}"
    return text


def validate(a, caption, tags, when, now=None):
    """Error messages for anything the platform would reject; empty list = fine."""
    spec, errors = PLATFORMS[a.platform], []
    # title_line: no title field, the title goes in as the caption's first line (optional).
    head = len(a.title) + 1 if a.title and spec.get("title_line") else 0
    if spec["title"] and not a.title and not spec.get("title_line"):
        errors.append(f"{a.platform} needs --title")
    if a.title and spec["title"] and len(a.title) > spec["title"]:
        errors.append(f"title is {len(a.title)} chars, {a.platform} allows {spec['title']}")
    if a.title and not spec["title"]:
        errors.append(f"{a.platform} has no title field: put it in --caption")
    bad = [c for c in spec.get("forbidden", "") if c in (a.title or "") + caption]
    if bad:
        errors.append(f"{a.platform} rejects the characters {''.join(bad)} in title/caption")
    size = (x_weight(caption) if a.platform == "x" else len(caption)) + head
    if size > spec["caption"]:
        errors.append(f"caption is {size} chars, {a.platform} allows {spec['caption']}")
    if tags and not spec["tags"]:
        errors.append(f"{a.platform} has no tags field: put #hashtags in --caption")
    if spec["tags"] and len(",".join(tags)) > spec["tags"]:
        errors.append(f"tags are {len(','.join(tags))} chars, {a.platform} allows {spec['tags']}")
    if a.platform == "meta" and not (getattr(a, "asset", None) or {}).get("asset_id"):
        errors.append("meta needs --asset BUSINESS_ID:ASSET_ID (Business Suite URL of the Page)")
    if "targets" in spec:
        unknown = set(a.targets or []) - spec["targets"]
        if not a.targets or unknown:
            errors.append(f"--targets must be a subset of {','.join(sorted(spec['targets']))}")
        ig = getattr(a, "caption_ig", None) or caption
        if "instagram" in (a.targets or []) and ig.count("#") > 30:
            errors.append("instagram allows at most 30 hashtags")
        if len(ig) + head > spec["caption"]:
            errors.append(f"instagram caption is {len(ig) + head} chars, {a.platform} allows {spec['caption']}")
    if when:
        lead = when - (now or datetime.now(timezone.utc))
        lo, hi = spec["schedule"]
        if not lo <= lead <= hi:
            errors.append(f"--at must be {lo} to {hi.days} days ahead for {a.platform}, it is {lead}")
    return errors


def stage(src, item_id, role, suffixes):
    src = Path(src).expanduser()
    if not src.is_file():
        sys.exit(f"file not found: {src}")
    if src.suffix.lower() not in suffixes:
        sys.exit(f"{src.name}: {role} must be one of {' '.join(sorted(suffixes))}")
    name = f"{item_id}-{role}{src.suffix.lower()}"
    shutil.copyfile(src, ROOT / name)
    # The copy's size, not the source's: a source rewritten during the copy (a cover re-rendered by a
    # running sync) left a size the queued file does not have, and the extension's transfer broke on it.
    return {"file": name, "name": src.name, "size": (ROOT / name).stat().st_size}


def retire_renamed(source, platform, account):
    """Archive pending items of this video whose folder was renamed since they were queued.

    Renumbering or rescheduling a Desktop folder changes the source path, so the next sync queued
    the same video again and the old item stayed. An item counts as the same video when platform,
    account and file name match and its old path is gone. Items already uploading (claimed or with
    a video_id) stay. Returns the ids moved to done/ with status "superseded"."""
    name = Path(source).name
    gone = []
    with queue_lock():
        for p in ROOT.glob("*.json"):
            try:
                i = json.loads(p.read_text())
            except (OSError, ValueError):
                continue
            old = i.get("source") or ""
            if (old == source or Path(old).name != name or i.get("platform") != platform
                    or i.get("account") != account or Path(old).exists()
                    or i.get("video_id") or p.with_suffix(".claim").is_file()):
                continue
            DONE.mkdir(exist_ok=True)
            (DONE / p.name).write_text(json.dumps(i | {"status": "superseded", "superseded_by": source},
                                                  indent=2, ensure_ascii=False))
            p.unlink()
            for media in (i.get("video"), i.get("cover")):
                if media and (ROOT / media["file"]).is_file():
                    (ROOT / media["file"]).replace(DONE / media["file"])
            gone.append(i["id"])
    return gone


def enqueue(a):
    caption = sys.stdin.read().rstrip("\n") if a.caption == "-" else (a.caption or "")
    tags = [t.strip() for t in (a.tags or "").split(",") if t.strip()]
    when = parse_schedule(a.at, a.tz)
    errors = validate(a, caption, tags, when)
    if errors:
        sys.exit("\n".join(errors))
    source = str(Path(a.file).expanduser().resolve())
    retire_renamed(source, a.platform, a.account)
    # Check and write under one lock: two callers (the gateway's sync, a Telegram tap, `postq episode`)
    # each passed the check before either wrote, and the popup showed one video twice. Its own lock:
    # staging copies the video, and the queue server must not wait on that.
    with enqueue_lock():
        return _enqueue(a, caption, tags, when, source)


def same_video(i, platform, account, source):
    """The stable key of a queued post: platform, account and the video's file name (its folder may be renamed)."""
    return (i.get("platform") == platform and i.get("account") == account
            and Path(i.get("source") or "").name == Path(source).name)


def _enqueue(a, caption, tags, when, source):
    queued = next((i for i in pending() if same_video(i, a.platform, a.account, source)), None)
    if queued:
        if getattr(a, "cover", None) and not queued.get("cover") and not queued.get("claimed"):
            # Queued before this platform got covers (TikTok before #388): without one the adapter skips
            # Edit cover, so give it the cover now instead of posting with TikTok's default frame.
            fixed = {**queued, "cover": stage(a.cover, queued["id"], "cover", IMAGE_SUFFIXES)}
            (ROOT / f"{queued['id']}.json").write_text(json.dumps(fixed, indent=2, ensure_ascii=False))
            sys.exit(f"already queued for {a.platform}, cover added: {source}")
        sys.exit(f"already queued for {a.platform}: {source}")
    # Posted before (the dashboard tick can lag or miss): never a second copy on the same account.
    for f in (ROOT / "done").glob("*.json"):
        d = json.loads(f.read_text())
        if (d.get("source") == source and d["platform"] == a.platform and d.get("account") == a.account
                and d.get("status") in ("posted", "scheduled")):
            sys.exit(f"already {d['status']} on {a.platform} ({a.account}): {source} · {d.get('url') or d['id']}")
    if a.platform not in READY:
        print(f"note: no {a.platform} adapter yet, the item waits in the queue", file=sys.stderr)
    ROOT.mkdir(parents=True, exist_ok=True)
    item_id = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:6]
    item = {
        "id": item_id,
        "platform": a.platform,
        "targets": a.targets or [],
        "account": a.account,
        "video": stage(a.file, item_id, "video", VIDEO_SUFFIXES),
        "cover": stage(a.cover, item_id, "cover", IMAGE_SUFFIXES) if a.cover else None,
        "title": a.title or "",
        "caption": caption,
        "caption_ig": getattr(a, "caption_ig", None),  # meta: own Instagram caption ("Customise post")
        "asset": getattr(a, "asset", None),  # meta: Business Suite {business_id, asset_id} of the account
        "tags": tags,
        "playlist": getattr(a, "playlist", None),
        "related": getattr(a, "related", None),
        "channel": getattr(a, "channel", None),
        "source": str(Path(a.file).expanduser().resolve()),
        "visibility": a.visibility,
        "schedule_at": when.isoformat() if when else None,
        "tz": a.tz or str(datetime.now().astimezone().tzinfo),
        "made_for_kids": a.made_for_kids,
        "dry_run": a.dry_run,
        "auto": a.auto and not auto_blocked(),
        "rush": bool(getattr(a, "now", False)),  # --now: the extension starts it at once, past the Meta gap
        "created": time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    (ROOT / f"{item_id}.json").write_text(json.dumps(item, indent=2, ensure_ascii=False))
    ensure_server()
    return item_id


_ITEMS = {}  # path -> (mtime_ns, size, item); read-only callers share the dicts


def read_item(p):
    """Parsed item JSON, re-read only when the file changed: opening a file costs ~7 ms on this Mac
    (endpoint scanner), so re-reading ~800 items on every popup poll took 2-13 s and the list never opened."""
    st = p.stat()
    hit = _ITEMS.get(p)
    if hit and hit[:2] == (st.st_mtime_ns, st.st_size):
        return hit[2]
    item = json.loads(p.read_text())
    _ITEMS[p] = (st.st_mtime_ns, st.st_size, item)
    return item


def with_disk_sizes(item):
    """The extension pulls media in ranges up to `size`: give it the queued file's real size."""
    for role in ("video", "cover"):
        m = item.get(role)
        if isinstance(m, dict) and m.get("file") and (f := ROOT / m["file"]).is_file():
            m["size"] = f.stat().st_size
    return item


def pending():
    # Studio switches channel for the whole login, so YouTube posts one channel at a time: the
    # channel of the last finished YouTube post stays first until it is done. Business Suite and X
    # pick the account per post (no switch cost), so they go between, earliest slot first.
    items = []
    for p in ROOT.glob("*.json"):
        try:
            items.append(with_disk_sizes(read_item(p)))
        except (OSError, ValueError):  # archived or half-written between glob and read: next poll has it
            continue
    yt_done = sorted((d for d in (ROOT / "done").glob("*.json")), key=lambda p: p.stat().st_mtime)
    cur = next((a for a in (read_item(p) for p in reversed(yt_done))
                if a.get("platform") == "youtube"), {}).get("account")

    def key(i):
        yt = i.get("platform") == "youtube"
        return (yt and i.get("account") != cur, yt, i.get("video_id") != "meta-submitted", i.get("account") or "", i.get("schedule_at") or "", i["id"])
    return sorted(items, key=key)


