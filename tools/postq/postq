@contextmanager
def queue_lock():
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / ".lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


@contextmanager
def enqueue_lock():
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / ".enqueue.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def retire_duplicates():
    """Archive second queue items of one video (same platform, account and file name): one card per video.

    The one kept is the one already uploading (claimed or with a video_id), else approved, else the oldest.
    The others move to done/ with status "duplicate". Returns their ids."""
    with queue_lock():
        groups = {}
        for p in sorted(ROOT.glob("*.json")):
            try:
                i = json.loads(p.read_text())
            except (OSError, ValueError):
                continue
            k = (i.get("platform"), i.get("account"), Path(i.get("source") or i["id"]).name)
            groups.setdefault(k, []).append((p, i))
        gone = []
        for items in groups.values():
            busy = lambda pi: bool(pi[1].get("video_id") or pi[0].with_suffix(".claim").is_file())  # noqa: E731
            items.sort(key=lambda pi: (not busy(pi), not pi[1].get("auto"), pi[1]["id"]))
            for p, i in items[1:]:
                if busy((p, i)):
                    continue  # two uploads already running: leave both to finish
                DONE.mkdir(exist_ok=True)
                (DONE / p.name).write_text(json.dumps(i | {"status": "duplicate", "duplicate_of": items[0][1]["id"]},
                                                      indent=2, ensure_ascii=False))
                p.unlink()
                for media in (i.get("video"), i.get("cover")):
                    if media and (ROOT / media["file"]).is_file():
                        (ROOT / media["file"]).replace(DONE / media["file"])
                gone.append(i["id"])
    return gone


@contextmanager
def sync_lock():
    """True while this process alone syncs; False when another sync already runs.

    The gateway syncs every minute and a manual `postq sync` can overlap it: both read the queue
    before either writes, so the same video went in twice."""
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / ".sync.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        yield True


def server_running():
    with socket.socket() as s:
        return s.connect_ex(("127.0.0.1", PORT)) == 0


def auto_blocked():
    if why := ext_ready():
        print(f"not auto-posting: {why}. Then: postq approve <id>", file=sys.stderr)
    return bool(why)


def ext_ready():
    """None when a current extension polled in the last 90 s, else what is wrong."""
    if not POLLED.is_file() or time.time() - POLLED.stat().st_mtime > 90:
        return "the post-approve extension is not polling (Chrome closed, or extension not loaded)"
    v = POLLED.read_text().strip()
    try:
        ver = tuple(int(x) for x in v.split(".")) if "." in v else (0,)  # 0.1 sent a bare "1"
    except ValueError:
        ver = (0,)
    if ver < EXT_MIN:
        return (f"the post-approve extension is version {v or 'old'}, needs {'.'.join(map(str, EXT_MIN))}: "
                "chrome://extensions -> reload post-approve")
    return None


def dashboard_posted(video_name):
    """Platforms ticked for this video on the museai dashboard; None when it is not listed there."""
