class Handler(BaseHTTPRequestHandler):
    def _send(self, code, body=b"", ctype="application/json", extra=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def _local(self):
        # DNS rebinding: only requests addressed to us by name get an answer.
        return self.headers.get("Host") in (f"127.0.0.1:{PORT}", f"localhost:{PORT}")

    def _item_path(self):
        item_id = self.path.removesuffix("/claim").removesuffix("/release").removesuffix("/approve").removesuffix("/mark").rsplit("/", 1)[-1]
        p = ROOT / f"{item_id}.json"
        return p if p.parent == ROOT and p.is_file() else None

    def do_GET(self):
        if not self._local():
            return self._send(403)
        if self.path == "/api/items":
            if v := self.headers.get("X-Postq-Poller"):
                POLLED.write_text(v)
            return self._send(200, json.dumps(pending(), ensure_ascii=False).encode())
        if self.path == "/api/tracked":
            # YouTube video ids the queue owns (pending or done): the extension's duplicate cleaner
            # never offers these for deletion.
            ids = {}
            for p in [*ROOT.glob("*.json"), *DONE.glob("*.json")]:
                try:
                    d = read_item(p)
                except (OSError, ValueError):
                    continue
                if d.get("platform") != "youtube":
                    continue
                vid = d.get("video_id") or (re.search(r"(?:shorts/|[?&]v=)([\w-]{11})", d.get("url") or "") or [None, None])[1]
                if vid:
                    ids[vid] = {"account": d.get("account"), "title": d.get("title"), "item": d["id"]}
            return self._send(200, json.dumps(ids, ensure_ascii=False).encode())
        if self.path.startswith("/media/"):
            p = ROOT / Path(self.path[7:]).name
            if p.is_file() and p.suffix != ".json":
                return self._media(p)
        self._send(404)

    def _media(self, p):
        """Range support: the extension pulls a large video in chunks instead of holding one huge buffer."""
        size = p.stat().st_size
        ctype = mimetypes.guess_type(p.name)[0] or "application/octet-stream"
        rng = self.headers.get("Range", "")
        if not rng.startswith("bytes="):
            return self._send(200, p.read_bytes(), ctype, {"Accept-Ranges": "bytes"})
        start, _, end = rng[6:].partition("-")
        start, end = int(start), min(int(end) if end else size - 1, size - 1)
        with p.open("rb") as f:
            f.seek(start)
            body = f.read(end - start + 1)
        self._send(206, body, ctype, {"Content-Range": f"bytes {start}-{end}/{size}", "Accept-Ranges": "bytes"})

    def do_POST(self):
        # /api/items/<id>/claim   200 for the first poster, 409 while another holds a live claim
        # /api/items/<id>/approve body {edited fields}: auto-post it (panel's Approve all)
        # /api/items/<id>/release body {error}: drop the claim after a failed post
        # /api/items/<id>/mark    body {video_id}: saved before the extension presses publish, so a retry
        #                         (even after the extension died mid-post) only checks, never posts twice
        # /api/items/<id>         body {status, url?, error?, log?, + edited fields}: archive with the outcome
        if not self._local():
            return self._send(403)
        p = self._item_path()
        if not self.headers.get(GUARD_HEADER) or not p:
            return self._send(404)
        claim = p.with_suffix(".claim")
        if self.path.endswith("/claim"):
            with CLAIM_LOCK:
                if claim.is_file() and time.time() - claim.stat().st_mtime < CLAIM_TTL:
                    return self._send(409)
                claim.write_text("")
            return self._send(200, b"{}")
        body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or "{}")
        if self.path.endswith("/approve"):
            # The panel's "Approve all": same as `postq approve` plus the card's edits; the
            # extension's lanes then post it (several at once, one YouTube channel at a time).
            with queue_lock():
                if not p.is_file():
                    return self._send(404)
                item = json.loads(p.read_text()) | {k: body[k] for k in EDITABLE if k in body}
                item |= {"auto": True, "last_error": None}
                tmp = p.with_suffix(".tmp")
                tmp.write_text(json.dumps(item, indent=2, ensure_ascii=False))
                tmp.replace(p)
                return self._send(200, b"{}")
        if self.path.endswith("/mark"):
            if not body.get("video_id"):
                return self._send(400)
            with queue_lock():
                if p.is_file():
                    item = json.loads(p.read_text()) | {"video_id": body["video_id"]}
                    tmp = p.with_suffix(".tmp")
                    tmp.write_text(json.dumps(item, indent=2, ensure_ascii=False))
                    tmp.replace(p)
            return self._send(200, b"{}")
        if self.path.endswith("/release"):
            # A failed post stays pending; its error is kept so `postq wait` / `list` can show it,
            # and `auto` is dropped so it is not retried until approved again.
            with queue_lock():
                if p.is_file():
                    item = json.loads(p.read_text()) | {"last_error": body.get("error"), "auto": False}
                    if body.get("video_id"):  # uploaded before it failed: the retry resumes that video
                        item["video_id"] = body["video_id"]
                    tmp = p.with_suffix(".tmp")
                    tmp.write_text(json.dumps(item, indent=2, ensure_ascii=False))
                    tmp.replace(p)
                    page_outcome(item, False, body.get("error"))
            claim.unlink(missing_ok=True)
            return self._send(200, b"{}")
        with queue_lock():
            if not p.is_file():
                return self._send(404)
            item = json.loads(p.read_text())
            item |= {k: body[k] for k in EDITABLE if k in body} | {k: body.get(k) for k in OUTCOME}
            DONE.mkdir(exist_ok=True)
            (DONE / p.name).write_text(json.dumps(item, indent=2, ensure_ascii=False))
            p.unlink()
        claim.unlink(missing_ok=True)
        for media in (item["video"], item.get("cover")):
            if media and (ROOT / media["file"]).is_file():
                (ROOT / media["file"]).replace(DONE / media["file"])
        if item.get("status") in ("scheduled", "posted"):
            threading.Thread(target=mark_dashboard, args=(item,), daemon=True).start()
        if item.get("status") not in ("dry-run", "discarded"):
            page_outcome(item, item.get("status") in ("scheduled", "posted"), item.get("error"))
        self._send(200, b"{}")

    def log_message(self, *args):
        pass


META_AHEAD = timedelta(days=28) - timedelta(minutes=10)  # Business Suite schedules at most 28 days out
BOX_PLATFORM = {"youtube": "youtube", "facebook": "meta", "instagram": "meta", "x": "x", "tiktok": "tiktok"}


def open_boxes(v, feed):
    """The video's platforms still to post. A gateway started before the feed had `open` sends none:
    then it is what the dashboard page shows unticked, the channel's platforms minus the posted ones."""
    if isinstance(v.get("open"), list):
        return v["open"]
    chans = {c.get("id"): c.get("platforms") for c in feed.get("channels") or []}
    plats = chans.get(v.get("channel")) or [p.get("id") if isinstance(p, dict) else p for p in feed.get("platforms") or []]
    return [p for p in plats if not (v.get("posted") or {}).get(p)]


def retire_gone(feed):
    """Archive pending items whose video left the dashboard and whose folder is gone (posted, then trashed).

    Their cards never show (the popup follows the dashboard), but they stayed in the queue for good.
    Items already uploading (claimed or with a video_id) stay. Returns the ids moved to done/ with
    status "gone"."""
    if not isinstance(feed.get("videos"), list):
        return []
    listed = {v.get("name") for v in feed["videos"]}
    gone = []
    with queue_lock():
        for p in ROOT.glob("*.json"):
            try:
                i = json.loads(p.read_text())
            except (OSError, ValueError):
                continue
            src = i.get("source") or ""
            if ((i.get("video") or {}).get("name") in listed or not src or Path(src).exists()
                    or i.get("video_id") or p.with_suffix(".claim").is_file()):
                continue
            DONE.mkdir(exist_ok=True)
            (DONE / p.name).write_text(json.dumps(i | {"status": "gone"}, indent=2, ensure_ascii=False))
            p.unlink()
            for media in (i.get("video"), i.get("cover")):
                if media and (ROOT / media["file"]).is_file():
                    (ROOT / media["file"]).replace(DONE / media["file"])
            gone.append(i["id"])
    return gone


def sync_dashboard(now=None, fetch=None):
    """Queue every video the dashboard still lists as open that has no queue item yet.

    The dashboard (folders with a .museai-post marker) is the source of truth: each platform in a
    video's `open` list (the dashboard leaves out ticked ones and those outside the channel's own list,
    Healing: no X/TikTok/Threads) gets its queue item here, `enqueue` dedupes by source + platform. Meta slots beyond the
    28-day window wait and enter the queue by themselves once inside it. Returns episode folders queued."""
    now = now or datetime.now(timezone.utc)
    try:
        d = fetch() if fetch else json.load(urllib.request.urlopen(f"{MUSEAI_BASE}/dashboard/posts", timeout=10))
    except Exception:
        return []
    for iid in retire_gone(d):
        print(f"gone from the dashboard, archived {iid}", flush=True)
    done = []
    for v in d.get("videos", []):
        f = Path(v["folder"]) if v.get("folder") else None  # the dashboard names the folder: launchd's python may not read ~/Desktop
        if not f or not v.get("slot"):
            continue
        want = []
        for box in open_boxes(v, d):  # the dashboard's own list of platforms still to post
            plat = BOX_PLATFORM.get(box)
            if not plat or plat in want:
                continue
            if plat == "meta":
                at = (v.get("schedule") or {}).get("facebook") or (v.get("schedule") or {}).get("instagram")
                if at and datetime.fromisoformat(at) - now > META_AHEAD:
                    continue
            want.append(plat)
        if want:
            try:
                cmd_episode(argparse.Namespace(dir=str(f), platforms=want, at=None, related=None, dry_run=False,
                                               auto=False, now=False, no_render=True))
                done.append(f.name)
            except SystemExit:
                pass  # a platform's limit or an already queued item: the others still went through
            except Exception as e:
                print(f"sync {f.name}: {e}", file=sys.stderr, flush=True)
    return done


def cmd_sync(_):
    """One sync pass. The museai gateway runs this every minute: launchd's python cannot read ~/Desktop."""
    with sync_lock() as mine:
        if not mine:
            print("another sync is running, skipped")
            return
        for iid in retire_duplicates():
            print(f"duplicate archived {iid}")
        for name in sync_dashboard():
            print(f"queued {name}")


def cmd_serve(_):
    ROOT.mkdir(parents=True, exist_ok=True)
    print(f"postq serving {ROOT} on http://127.0.0.1:{PORT}", flush=True)
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()


def main():
    ap = argparse.ArgumentParser(prog="postq")
    sub = ap.add_subparsers(dest="cmd", required=True)
    add = sub.add_parser("add")
    add.add_argument("--platform", required=True, choices=sorted(PLATFORMS))
    add.add_argument("--targets", type=lambda s: [t.strip() for t in s.split(",") if t.strip()],
                     help="meta only: facebook,instagram (one Business Suite post for both)")
    add.add_argument("--account", required=True, help="channel/page name or id the post must go to; checked before posting")
    add.add_argument("--file", required=True, help="the video")
    add.add_argument("--cover", help="thumbnail image")
    add.add_argument("--title", help="youtube title; meta: first line of the FB/IG caption (skipped when it already is)")
    add.add_argument("--caption", help="description/caption, or - to read stdin")
    add.add_argument("--caption-ig", help="meta: own Instagram caption (default: --caption for both)")
    add.add_argument("--asset", type=lambda s: dict(zip(("business_id", "asset_id"), s.split(":"))),
                     help="meta: BUSINESS_ID:ASSET_ID of the Page (default: switch to --account by name)")
    add.add_argument("--tags", help="comma-separated (youtube)")
    add.add_argument("--at", help='publish time "YYYY-MM-DD HH:MM"; omit to publish on approve')
    add.add_argument("--tz", help="IANA zone of --at (default: this machine's)")
    add.add_argument("--related", help='youtube Shorts related video: "Tập 36", a full title, or "latest:Tập"')
    add.add_argument("--playlist", help="youtube playlist name (accents/case ignored); must already exist")
    add.add_argument("--visibility", default="public", choices=["public", "unlisted", "private"])
    add.add_argument("--made-for-kids", action="store_true")
    add.add_argument("--dry-run", action="store_true", help="fill the form, never press the final button")
    add.add_argument("--auto", action="store_true", help="post without a click")
    ep = sub.add_parser("episode", help="queue an episode folder: title, caption and time from its captions.txt")
    ep.add_argument("dir")
    ep.add_argument("--platforms", default=DEFAULT_PLATFORMS, type=lambda s: [t.strip() for t in s.split(",") if t.strip()],
                    help="comma list of youtube,meta,tiktok,x (default: all four; x/tiktok only for series with an x_account/tiktok_account)")
    ep.add_argument("--at", help="override the captions.txt time")
    ep.add_argument("--related", help='youtube related video: "Tập 36" or a full title (default: the series\' rule)')
    ep.add_argument("--dry-run", action="store_true")
    ep.add_argument("--auto", action="store_true")
    ep.add_argument("--now", action="store_true", help="post right away, ignore the captions.txt time")
    ep.add_argument("--no-render", action="store_true", help="no thumbnail in the folder: queue without one "
                    "instead of rendering it with muse")
    eps = sub.add_parser("episodes", help="queue every episode folder of a series (e.g. all Chinese ones on the Desktop)")
    eps.add_argument("--series", default="Chinese", help=f"one of {', '.join(SERIES)}, or all")
    eps.add_argument("--root", default="~/Desktop")
    for act in ep._actions[2:]:  # the same options as `episode` (minus dir)
        eps._add_action(act)
    ap_ = sub.add_parser("approve")
    ap_.add_argument("ids", nargs="+")
    ap_.add_argument("--now", action="store_true", help="post right away instead of at its scheduled time")
    ap_.add_argument("--video", help="already uploaded as this YouTube video id: schedule and check it, no new upload")
    sub.add_parser("list")
    sub.add_parser("results")
    sub.add_parser("serve")
    sub.add_parser("sync", help="queue every open dashboard video that has no queue item")
    wait = sub.add_parser("wait")
    wait.add_argument("ids", nargs="*")
    wait.add_argument("--timeout", type=float, default=0)
    a = ap.parse_args()
    {"add": cmd_add, "list": cmd_list, "results": cmd_results, "serve": cmd_serve, "sync": cmd_sync, "wait": cmd_wait,
     "approve": cmd_approve, "episode": cmd_episode,
     "episodes": cmd_episodes}[a.cmd](a)


if __name__ == "__main__":
    main()
