#!/usr/bin/env bash
# Usage: shot "brief" out.mp4
# Renders one healing shot through muse-video (9:16, 6 s, QUALITY=0) with ../prompt/healing.txt
# appended (calm handheld, real gentle motion, ambience only, no music, no text). One line per shot
# in a jobs file for ../../muse-video/scripts/render-queue (one shot at a time, the next when one
# finishes; never every shot in its own background call: that overloads the CPU).
# Env passed through to muse-video: IMAGE=first_frame.png SIZE= DURATION=
set -euo pipefail
SKILL_DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
MUSE_VIDEO="$SKILL_DIR/../muse-video/scripts/muse-video"
# hv-0017 looked AI: cosy-bait words make muse stack candles, lamps, flowers and an orange glow.
# BRIEF_OK=1 skips the check.
bait=$(grep -oiE '\b(cos[yi]e?|cozy|magical|dreamy|cinematic|enchant[a-z]*|fairy lights?|glow(ing)?|candle(s|light)?|lamp ?light|golden glow|tripod|phone on|perfect(ly arranged)?)\b' <<<"$1" | grep -viE '^perfectly$' | sort -fu | paste -sd, - || true)
if [[ -n $bait && -z ${BRIEF_OK:-} ]]; then
  echo "shot: brief has AI-look bait words ($bait); describe plain real light and few objects (SKILL.md Real look)" >&2
  exit 2
fi
out=$(cd "$(dirname "$2")" && pwd)/$(basename "$2")
prompt="NO TEXT ON SCREEN. $1

$(cat "$SKILL_DIR/prompt/healing.txt")"
QUALITY=0 SIZE=${SIZE:-9:16} DURATION=${DURATION:-6} OUT_NAME=$(basename "$out") NO_OPEN=1 \
  "$MUSE_VIDEO" "$prompt" "$(dirname "$out")"
