#!/usr/bin/env bash
# Usage: music "<idea's music field>" out.m4a [seconds=32] [seed=random] [flavour=auto]
# Instrumental dream track with ACE-Step, through healing-video's ace_piano.py (generic tags -> wav)
# and lnorm.py (starts at the track's body, two-pass level). Warm vintage top end like the
# references (they roll off above ~5 kHz), -16 LUFS before the mix.
# Every video sounds different (user rule 2026-11-01): flavour picks one style from FLAVOURS
# (auto: the first one not used by the last 4 videos in the history, then a random one). The idea's
# own music field is used only with flavour=look. Writes out.json {flavour, seed} next to the track;
# pass it to `ideas.py record --music out.json`.
set -euo pipefail
SKILL_DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
HV=${HEALING_SCRIPTS:-$SKILL_DIR/../healing-video/scripts}
MV=${MUSE_VIDEO_SCRIPTS:-$SKILL_DIR/../muse-video/scripts}
style=$1; out=$2; secs=${3:-32}; seed=${4:-$((RANDOM * 7 + 1))}; flavour=${5:-auto}
read -r flavour style < <(python3 - "$flavour" "$style" <<'PY'
import json, random, sys
from pathlib import Path
FLAVOURS = {
    "doowop": "dreamy 1950s doo-wop ballad, soft vibraphone melody, warm upright bass, brushed snare, slow 6/8 sway, 72 bpm",
    "swing": "playful 1950s swing, muted trumpet and clarinet melody, walking bass, brushed drums, finger snaps, 112 bpm",
    "bossa": "gentle bossa nova, nylon guitar, soft flute melody, shaker, warm upright bass, 96 bpm",
    "musette": "whimsical French musette waltz, accordion melody, pizzicato strings, light 3/4, 100 bpm",
    "ukulele": "sunny ukulele and whistled melody, light hand claps, glockenspiel, bouncy, 104 bpm",
    "minuet": "playful baroque harpsichord minuet, chamber strings, 3/4, 92 bpm",
    "lullaby": "music box lullaby, harp arpeggios, soft legato strings, 70 bpm",
    "lofi": "dreamy lo-fi, soft Rhodes piano melody, vinyl crackle, mellow laid-back beat, 80 bpm",
    "fairytale": "cinematic fairytale orchestra, flute and oboe melody, sweeping strings, french horn, 88 bpm",
    "cafejazz": "vintage Parisian cafe jazz, gypsy swing guitar, violin melody, upright bass, 120 bpm",
}
want, look_style = sys.argv[1], sys.argv[2]
if want == "look":
    print("look", look_style)
    sys.exit()
if want == "auto":
    hist = Path.home() / ".config/museai/dream-history.json"
    recent = [h.get("music", {}).get("flavour") for h in (json.loads(hist.read_text()) if hist.exists() else [])[-4:]]
    fresh = [f for f in FLAVOURS if f not in recent]
    want = random.choice(fresh)
print(want, FLAVOURS[want])
PY
)
tags="$style, clear memorable melody, magical, enchanted, sparkling celesta shimmer, dreamy, whimsical, gentle dynamics, warm vintage recording, instrumental, no vocals"
raw="${out%.*}.raw.wav"
if [[ -x ${ACE_PY:=${ACE_STEP_HOME:-$HOME/.local/share/ace-step}/venv/bin/python} ]]; then
  # one ACE render per machine: same lock file as music.py (macOS has no flock(1), so fcntl in python)
  python3 - "$(dirname "$(dirname "$(dirname "$ACE_PY")")")/render.lock" "$ACE_PY" "$HV/ace_piano.py" --tags "$tags" \
    --duration "$((secs + 6))" --seed "$seed" --out "$raw" <<'PY'
import fcntl, subprocess, sys
with open(sys.argv[1], "w") as lf:
    try:
        fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("another ACE render is running on this machine; waiting for it", file=sys.stderr)
        fcntl.flock(lf, fcntl.LOCK_EX)
    sys.exit(subprocess.run(sys.argv[2:]).returncode)
PY
else
  uv run --no-project "$MV/music.py" --engine musicgen --style "$tags" --bpm 76 --body-beats $((secs * 76 / 60)) --out "$raw.m4a"
  ffmpeg -v error -y -i "$raw.m4a" "$raw"
fi
start=$(python3 "$HV/lnorm.py" --body-start "$raw")
python3 "$HV/lnorm.py" "$raw" "$out" -16 "lowpass=f=6000,atrim=start=$start:duration=$secs,asetpts=PTS-STARTPTS,afade=in:d=0.3,afade=out:st=$((secs - 3)):d=3"
printf '{"flavour": "%s", "seed": %s}\n' "$flavour" "$seed" > "${out%.*}.json"
echo "$out  ($flavour, seed $seed)"
